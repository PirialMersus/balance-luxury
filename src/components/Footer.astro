---
import { brandConfiguration } from "../data/brand";
---

<footer class="luxury-site-footer">
  <div class="luxury-container footer-container">
    <div class="footer-top-grid">
      <div class="footer-brand-column">
        <div class="footer-brand-header">
          <img
            src="/images/brand/logo.webp"
            alt="Логотип студии Balance"
            width="52"
            height="52"
            class="footer-brand-logo"
            loading="lazy"
          />
          <div>
            <h3 class="footer-brand-name">{brandConfiguration.studioName}</h3>
            <span class="footer-brand-tagline">{brandConfiguration.studioTagline}</span>
          </div>
        </div>
        <p class="footer-brand-description">
          {brandConfiguration.studioDescription}
        </p>
      </div>

      <div class="footer-links-column">
        <h4 class="footer-column-heading">Навигация</h4>
        <ul class="footer-links-list">
          {brandConfiguration.footerNavigationItems.map((navigationEntry) => (
            <li class="footer-link-item">
              <a href={navigationEntry.href} class="footer-link-anchor">
                {navigationEntry.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-contacts-column">
        <h4 class="footer-column-heading">Связь и бронирование</h4>
        <p class="footer-contact-text">
          {brandConfiguration.locationDetails}
        </p>
        <div class="footer-social-wrapper">
          <span class="footer-social-label">Официальный канал:</span>
          <a
            href={brandConfiguration.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-instagram-link"
          >
            {brandConfiguration.instagramHandle}
          </a>
        </div>
        <div class="footer-social-wrapper">
          <span class="footer-social-label">Основательница:</span>
          <a
            href={brandConfiguration.founderInstagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-instagram-link"
          >
            {brandConfiguration.founderInstagramHandle}
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <p class="footer-copyright">
        &copy; 2026 {brandConfiguration.studioFullName}. Все права защищены.
      </p>
      <div class="footer-legal-links">
        <a href="/privacy" class="footer-legal-link">Политика конфиденциальности</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .luxury-site-footer {
    background-color: #2D2721;
    color: #FAF8F2;
    padding-top: clamp(4rem, 6vw, 6rem);
    padding-bottom: 2.5rem;
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-top-grid {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 4rem;
    }
  }

  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .footer-brand-logo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-brand-name {
    font-family: var(--font-family-serif);
    font-size: 1.75rem;
    color: #FAF8F2;
    line-height: 1.1;
  }

  .footer-brand-tagline {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-background-sand);
  }

  .footer-brand-description {
    color: #B5AFA6;
    font-size: 0.9375rem;
    max-width: 440px;
    line-height: 1.7;
  }

  .footer-column-heading {
    font-family: var(--font-family-sans);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-background-sand);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-link-anchor {
    color: #E2DDD5;
    font-size: 0.9375rem;
    transition: color var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .footer-link-anchor:hover {
    color: #FAF8F2;
    text-decoration: underline;
  }

  .footer-contact-text {
    color: #B5AFA6;
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .footer-social-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.875rem;
  }

  .footer-social-label {
    font-size: 0.75rem;
    color: #8C867C;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-instagram-link {
    color: #FAF8F2;
    font-size: 1rem;
    font-family: var(--font-family-serif);
    letter-spacing: 0.02em;
    display: inline-block;
  }

  .footer-instagram-link:hover {
    color: var(--color-background-sand);
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    font-size: 0.8125rem;
    color: #8C867C;
  }

  @media (min-width: 768px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-legal-link {
    color: #8C867C;
    transition: color var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .footer-legal-link:hover {
    color: #FAF8F2;
  }
</style>
