---
import { studioPracticesList } from "../data/practices";
---

<div
  class="luxury-booking-modal-overlay"
  id="luxuryBookingModalOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bookingModalTitle"
  aria-hidden="true"
>
  <div class="luxury-booking-modal-backdrop" id="bookingModalBackdrop"></div>

  <div class="luxury-booking-modal-dialog">
    <button
      type="button"
      class="booking-modal-close-button"
      id="bookingModalCloseButton"
      aria-label="Закрыть окно"
    >
      &times;
    </button>

    <div class="booking-modal-header" id="bookingModalHeader">
      <span class="luxury-badge">Камерная группа</span>
      <h2 class="booking-modal-title" id="bookingModalTitle">Запись на практику</h2>
      <p class="booking-modal-subtitle">
        Горячая йога при температуре 38–40°C. Оставьте контакт, администратор свяжется с вами для подтверждения.
      </p>
    </div>

    <form class="booking-modal-form" id="luxuryModalBookingForm" novalidate>
      <div class="modal-field-group">
        <label for="modalClientNameInput" class="modal-label">Имя *</label>
        <input
          type="text"
          id="modalClientNameInput"
          name="clientName"
          placeholder="Как к вам обращаться"
          class="modal-input"
          required
          minlength="2"
        />
        <span class="modal-validation-error" id="modalNameError">Укажите ваше имя</span>
      </div>

      <div class="modal-field-group">
        <label for="modalClientPhoneInput" class="modal-label">Телефон *</label>
        <input
          type="tel"
          id="modalClientPhoneInput"
          name="clientPhone"
          placeholder="+380 (__) ___-__-__"
          class="modal-input"
          required
          minlength="8"
        />
        <span class="modal-validation-error" id="modalPhoneError">Укажите номер телефона</span>
      </div>

      <div class="modal-field-group">
        <label for="modalPracticeSelect" class="modal-label">Практика и время</label>
        <select id="modalPracticeSelect" name="practiceSlug" class="modal-select">
          {studioPracticesList.map((practiceEntry) => (
            <option value={practiceEntry.slug}>
              {practiceEntry.title}
            </option>
          ))}
          <option value="morning-class">Утренний класс (09:30)</option>
          <option value="evening-class">Вечерний класс (18:30 / 19:00)</option>
          <option value="private-class">Индивидуальное занятие с Марией Мироновой</option>
        </select>
      </div>

      <div class="modal-checkbox-row">
        <input
          type="checkbox"
          id="modalPrivacyConsentCheckbox"
          name="privacyConsent"
          class="modal-checkbox"
          required
          checked
        />
        <label for="modalPrivacyConsentCheckbox" class="modal-checkbox-label">
          Согласен с <a href="/privacy" class="modal-privacy-link" target="_blank">политикой конфиденциальности</a>
        </label>
        <span class="modal-validation-error" id="modalConsentError">Необходимо согласие</span>
      </div>

      <button type="submit" class="luxury-button-primary modal-submit-button" id="modalSubmitButton">
        <span id="submitButtonText">Забронировать коврик</span>
      </button>
    </form>

    <div class="booking-success-view" id="bookingSuccessView" aria-hidden="true">
      <div class="success-badge-icon">&check;</div>
      <h3 class="success-title">Место забронировано</h3>
      <p class="success-lead" id="successLeadText">
        Ваша заявка принята.
      </p>

      <div class="success-details-card">
        <div class="success-detail-row">
          <span class="detail-label">Код бронирования:</span>
          <strong class="detail-value" id="successBookingCode">BALANCE-5231</strong>
        </div>
        <div class="success-detail-row">
          <span class="detail-label">Практика:</span>
          <span class="detail-value" id="successPracticeName">Горячая йога</span>
        </div>
      </div>

      <p class="success-instruction">
        Администратор свяжется с вами в течение 15 минут для подтверждения времени и отправит схему проезда в студию.
      </p>

      <button type="button" class="luxury-button-primary success-finish-button" id="successCloseButton">
        Отлично, жду звонка
      </button>
    </div>
  </div>
</div>

<script>
  const modalOverlay = document.getElementById("luxuryBookingModalOverlay");
  const modalBackdrop = document.getElementById("bookingModalBackdrop");
  const modalCloseButton = document.getElementById("bookingModalCloseButton");
  const modalForm = document.getElementById("luxuryModalBookingForm") as HTMLFormElement | null;
  const bookingSuccessView = document.getElementById("bookingSuccessView");
  const successCloseButton = document.getElementById("successCloseButton");
  const bookingModalHeader = document.getElementById("bookingModalHeader");

  const clientNameInput = document.getElementById("modalClientNameInput") as HTMLInputElement | null;
  const clientPhoneInput = document.getElementById("modalClientPhoneInput") as HTMLInputElement | null;
  const practiceSelect = document.getElementById("modalPracticeSelect") as HTMLSelectElement | null;
  const privacyConsentCheckbox = document.getElementById("modalPrivacyConsentCheckbox") as HTMLInputElement | null;

  const modalNameError = document.getElementById("modalNameError");
  const modalPhoneError = document.getElementById("modalPhoneError");
  const modalConsentError = document.getElementById("modalConsentError");
  const modalSubmitButton = document.getElementById("modalSubmitButton") as HTMLButtonElement | null;
  const submitButtonText = document.getElementById("submitButtonText");

  const successLeadText = document.getElementById("successLeadText");
  const successBookingCode = document.getElementById("successBookingCode");
  const successPracticeName = document.getElementById("successPracticeName");

  function openBookingModalWithParameters(desiredPracticeSlug?: string) {
    if (!modalOverlay) {
      return;
    }

    if (bookingModalHeader) {
      bookingModalHeader.style.display = "block";
    }
    if (modalForm) {
      modalForm.style.display = "flex";
    }
    if (bookingSuccessView) {
      bookingSuccessView.classList.remove("success-view-visible");
      bookingSuccessView.setAttribute("aria-hidden", "true");
    }

    if (desiredPracticeSlug && practiceSelect) {
      for (let optionIndex = 0; optionIndex < practiceSelect.options.length; optionIndex += 1) {
        if (practiceSelect.options[optionIndex].value === desiredPracticeSlug || practiceSelect.options[optionIndex].value.includes(desiredPracticeSlug)) {
          practiceSelect.selectedIndex = optionIndex;
          break;
        }
      }
    }

    modalOverlay.classList.add("modal-overlay-visible");
    modalOverlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";

    setTimeout(() => {
      clientNameInput?.focus();
    }, 150);
  }

  function closeBookingModal() {
    if (!modalOverlay) {
      return;
    }
    modalOverlay.classList.remove("modal-overlay-visible");
    modalOverlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";

    modalNameError?.classList.remove("error-visible");
    modalPhoneError?.classList.remove("error-visible");
    modalConsentError?.classList.remove("error-visible");
  }

  document.addEventListener("click", (clickEvent) => {
    const targetElement = clickEvent.target as HTMLElement | null;
    if (!targetElement) {
      return;
    }

    const triggerElement = targetElement.closest("[data-open-booking-modal]") as HTMLElement | null;
    if (triggerElement) {
      clickEvent.preventDefault();
      const practiceSlug = triggerElement.getAttribute("data-booking-practice") || undefined;
      openBookingModalWithParameters(practiceSlug);
    }
  });

  modalCloseButton?.addEventListener("click", closeBookingModal);
  modalBackdrop?.addEventListener("click", closeBookingModal);
  successCloseButton?.addEventListener("click", closeBookingModal);

  document.addEventListener("keydown", (keyboardEvent) => {
    if (keyboardEvent.key === "Escape" && modalOverlay?.classList.contains("modal-overlay-visible")) {
      closeBookingModal();
    }
  });

  modalForm?.addEventListener("submit", (formEvent) => {
    formEvent.preventDefault();

    let hasValidationError = false;

    if (!clientNameInput || clientNameInput.value.trim().length < 2) {
      modalNameError?.classList.add("error-visible");
      hasValidationError = true;
    } else {
      modalNameError?.classList.remove("error-visible");
    }

    if (!clientPhoneInput || clientPhoneInput.value.trim().length < 7) {
      modalPhoneError?.classList.add("error-visible");
      hasValidationError = true;
    } else {
      modalPhoneError?.classList.remove("error-visible");
    }

    if (!privacyConsentCheckbox || !privacyConsentCheckbox.checked) {
      modalConsentError?.classList.add("error-visible");
      hasValidationError = true;
    } else {
      modalConsentError?.classList.remove("error-visible");
    }

    if (hasValidationError) {
      return;
    }

    if (modalSubmitButton && submitButtonText) {
      modalSubmitButton.disabled = true;
      submitButtonText.textContent = "Сохранение...";
    }

    const candidateName = clientNameInput ? clientNameInput.value.trim() : "";
    const candidatePhone = clientPhoneInput ? clientPhoneInput.value.trim() : "";
    const selectedPracticeText = practiceSelect ? practiceSelect.options[practiceSelect.selectedIndex].text : "Горячая йога (38–40°C)";
    const bookingRegistrationCode = `BALANCE-${Math.floor(1000 + Math.random() * 9000)}`;

    const bookingRecord = {
      code: bookingRegistrationCode,
      createdAt: new Date().toISOString(),
      clientName: candidateName,
      clientPhone: candidatePhone,
      practice: selectedPracticeText,
      status: "pending_confirmation"
    };

    try {
      const existingBookings = JSON.parse(localStorage.getItem("balance_studio_bookings") || "[]");
      existingBookings.push(bookingRecord);
      localStorage.setItem("balance_studio_bookings", JSON.stringify(existingBookings));
    } catch {
      void 0;
    }

    setTimeout(() => {
      if (modalSubmitButton && submitButtonText) {
        modalSubmitButton.disabled = false;
        submitButtonText.textContent = "Забронировать коврик";
      }

      if (bookingModalHeader) {
        bookingModalHeader.style.display = "none";
      }

      if (modalForm) {
        modalForm.style.display = "none";
        modalForm.reset();
      }

      if (successBookingCode) {
        successBookingCode.textContent = bookingRegistrationCode;
      }
      if (successPracticeName) {
        successPracticeName.textContent = selectedPracticeText;
      }
      if (successLeadText) {
        successLeadText.textContent = `${candidateName}, коврик зарезервирован!`;
      }

      if (bookingSuccessView) {
        bookingSuccessView.classList.add("success-view-visible");
        bookingSuccessView.setAttribute("aria-hidden", "false");
      }
    }, 400);
  });
</script>

<style>
  .luxury-booking-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .luxury-booking-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(52, 44, 37, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .luxury-booking-modal-dialog {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 460px;
    background-color: #FAF8F2;
    border: 1px solid var(--color-border-subtle);
    box-shadow: 0 24px 48px rgba(52, 44, 37, 0.2);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    transform: translateY(16px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay-visible .luxury-booking-modal-dialog {
    transform: translateY(0) scale(1);
  }

  .booking-modal-close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .booking-modal-close-button:hover {
    color: var(--color-accent-olive);
  }

  .booking-modal-header {
    margin-bottom: 1.5rem;
  }

  .booking-modal-title {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.15rem);
  }

  .booking-modal-subtitle {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .booking-modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .modal-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .modal-input,
  .modal-select {
    width: 100%;
    padding: 0.85rem 1rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    border-radius: 0;
    transition: border-color var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .modal-input:focus,
  .modal-select:focus {
    outline: none;
    border-color: var(--color-accent-olive);
  }

  .modal-validation-error {
    display: none;
    font-size: 0.75rem;
    color: #A33A3A;
  }

  .error-visible {
    display: block;
  }

  .modal-checkbox-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .modal-checkbox {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent-olive);
    cursor: pointer;
  }

  .modal-checkbox-label {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .modal-privacy-link {
    color: var(--color-accent-olive);
    text-decoration: underline;
  }

  .modal-submit-button {
    width: 100%;
    margin-top: 0.5rem;
    padding: 1.1rem;
    cursor: pointer;
  }

  .booking-success-view {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0;
  }

  .success-view-visible {
    display: flex;
  }

  .success-badge-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--color-accent-olive);
    color: #FAF8F2;
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .success-title {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
  }

  .success-lead {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .success-details-card {
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .success-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .detail-label {
    color: var(--color-text-secondary);
  }

  .detail-value {
    color: var(--color-text-primary);
  }

  .success-instruction {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .success-finish-button {
    width: 100%;
  }
</style>
