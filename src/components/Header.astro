---
import { brandConfiguration } from "../data/brand";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="luxury-site-header">
  <div class="luxury-container header-inner-container">
    <a href="/" class="header-brand-link" aria-label="Перейти на главную страницу студии Balance">
      <img
        src="/images/brand/logo.webp"
        alt="Логотип студии йоги Balance"
        width="44"
        height="44"
        class="header-brand-logo-image"
      />
      <div class="header-brand-text-wrapper">
        <span class="header-brand-title">{brandConfiguration.studioName}</span>
        <span class="header-brand-subtitle">Hot Yoga · Одесса</span>
      </div>
    </a>

    <nav class="desktop-navigation" aria-label="Основная навигация">
      <ul class="desktop-navigation-list">
        {brandConfiguration.primaryNavigationItems.map((navigationEntry) => {
          const isItemActive = currentPath === navigationEntry.href || (navigationEntry.href !== "/" && currentPath.startsWith(navigationEntry.href));
          return (
            <li class="desktop-navigation-item">
              <a
                href={navigationEntry.href}
                class:list={["desktop-navigation-link", { "desktop-navigation-link-active": isItemActive }]}
              >
                {navigationEntry.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions-group">
      <button
        type="button"
        class="luxury-button-primary header-booking-button"
        data-open-booking-modal
      >
        {brandConfiguration.bookingActionLabel}
      </button>

      <button
        type="button"
        class="mobile-menu-toggle-button"
        id="mobileMenuOpenButton"
        aria-label="Открыть меню навигации"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="mobile-navigation-drawer" id="mobileNavigationDrawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <div class="header-brand-text-wrapper">
        <span class="header-brand-title">{brandConfiguration.studioName}</span>
        <span class="header-brand-subtitle">Hot Yoga · Одесса</span>
      </div>
      <button
        type="button"
        class="mobile-menu-close-button"
        id="mobileMenuCloseButton"
        aria-label="Закрыть меню"
      >
        &times;
      </button>
    </div>

    <nav class="mobile-navigation" aria-label="Мобильная навигация">
      <ul class="mobile-navigation-list">
        <li class="mobile-navigation-item">
          <a href="/" class="mobile-navigation-link">Главная</a>
        </li>
        {brandConfiguration.primaryNavigationItems.map((navigationEntry) => (
          <li class="mobile-navigation-item">
            <a href={navigationEntry.href} class="mobile-navigation-link">
              {navigationEntry.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-drawer-footer">
      <p class="mobile-drawer-note">{brandConfiguration.locationDetails}</p>
      <button
        type="button"
        class="luxury-button-primary mobile-booking-button"
        data-open-booking-modal
        id="mobileBookingTriggerButton"
      >
        Записаться на практику
      </button>
    </div>
  </div>
</header>

<script>
  const mobileMenuOpenButton = document.getElementById("mobileMenuOpenButton");
  const mobileMenuCloseButton = document.getElementById("mobileMenuCloseButton");
  const mobileNavigationDrawer = document.getElementById("mobileNavigationDrawer");
  const mobileBookingTriggerButton = document.getElementById("mobileBookingTriggerButton");

  function toggleMobileNavigationVisibility(shouldOpen: boolean) {
    if (!mobileNavigationDrawer || !mobileMenuOpenButton) {
      return;
    }
    if (shouldOpen) {
      mobileNavigationDrawer.classList.add("mobile-drawer-active");
      mobileNavigationDrawer.setAttribute("aria-hidden", "false");
      mobileMenuOpenButton.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    } else {
      mobileNavigationDrawer.classList.remove("mobile-drawer-active");
      mobileNavigationDrawer.setAttribute("aria-hidden", "true");
      mobileMenuOpenButton.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }
  }

  mobileMenuOpenButton?.addEventListener("click", () => toggleMobileNavigationVisibility(true));
  mobileMenuCloseButton?.addEventListener("click", () => toggleMobileNavigationVisibility(false));
  mobileBookingTriggerButton?.addEventListener("click", () => toggleMobileNavigationVisibility(false));
</script>

<style>
  .luxury-site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(245, 241, 232, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background-color var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .header-inner-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  .header-brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .header-brand-logo-image {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border-subtle);
  }

  .header-brand-text-wrapper {
    display: flex;
    flex-direction: column;
  }

  .header-brand-title {
    font-family: var(--font-family-serif);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-text-primary);
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  .header-brand-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  .desktop-navigation {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-navigation {
      display: block;
    }
  }

  .desktop-navigation-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .desktop-navigation-link {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    font-weight: 400;
    position: relative;
    padding-bottom: 4px;
  }

  .desktop-navigation-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 1px;
    background-color: var(--color-accent-olive);
    transition: width var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .desktop-navigation-link:hover::after,
  .desktop-navigation-link-active::after {
    width: 100%;
  }

  .desktop-navigation-link-active {
    color: var(--color-accent-olive);
    font-weight: 500;
  }

  .header-actions-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-booking-button {
    display: none;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
  }

  @media (min-width: 768px) {
    .header-booking-button {
      display: inline-flex;
    }
  }

  .mobile-menu-toggle-button {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle-button {
      display: none;
    }
  }

  .hamburger-line {
    width: 100%;
    height: 1.5px;
    background-color: var(--color-text-primary);
    transition: transform var(--transition-smooth-duration) var(--transition-smooth-timing);
  }

  .mobile-navigation-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-background-primary);
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transform: translateY(-100%);
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  .mobile-drawer-active {
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-menu-close-button {
    background: transparent;
    border: none;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-navigation {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
  }

  .mobile-navigation-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-navigation-link {
    font-family: var(--font-family-serif);
    font-size: 2rem;
    color: var(--color-text-primary);
    display: inline-block;
  }

  .mobile-drawer-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-drawer-note {
    font-size: 0.875rem;
  }

  .mobile-booking-button {
    width: 100%;
  }
</style>
